<?xml version="1.0"?>
<sdf version="1.9">
  <model name="stage1_stoneware_cylinder">
    <link name="stoneware_link">
      <inertial>
        <mass>0.25</mass>
        <inertia>
          <ixx>0.0003125</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0103645833333</iyy>
          <iyz>0</iyz>
          <izz>0.0103645833333</izz>
        </inertia>
      </inertial>
      <collision name="stoneware_collision">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.70</length>
          </cylinder>
        </geometry>
        <pose>0 0 0 0 1.570796327 0</pose>
        <surface>
          <friction>
            <bullet>
              <friction>0.9</friction>
              <friction2>0.9</friction2>
              <rolling_friction>0.05</rolling_friction>
            </bullet>
          </friction>
          <bounce>
            <restitution_coefficient>0.02</restitution_coefficient>
            <threshold>100000</threshold>
          </bounce>
        </surface>
      </collision>
      <sensor name="stoneware_contact_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <contact>
          <collision>stoneware_collision</collision>
        </contact>
      </sensor>
      <visual name="stoneware_visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.70</length>
          </cylinder>
        </geometry>
        <pose>0 0 0 0 1.570796327 0</pose>
        <material>
          <ambient>0.30 0.16 0.11 1</ambient>
          <diffuse>0.52 0.29 0.20 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
