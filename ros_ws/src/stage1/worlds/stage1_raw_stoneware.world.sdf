<?xml version="1.0"?>
<sdf version="1.9">
  <world name="stage1_raw_stoneware">
    <physics name="stage1_physics" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine>
        <filename>gz-physics-bullet-featherstone-plugin</filename>
      </engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <gravity>0 0 -9.81</gravity>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://stage1_pallet</uri>
      <name>stage1_pallet</name>
      <pose>0.62 -0.18 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://stage1_placement_table</uri>
      <name>stage1_placement_table</name>
      <pose>-0.15 0.5 0 0 0 0</pose>
    </include>

    <model name="placement_target_region">
      <static>true</static>
      <pose>-0.15 0.5 0.551 0 0 0</pose>
      <link name="target_region_link">
        <visual name="target_region_visual">
          <geometry>
            <box>
              <size>0.95 0.4 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.55 0.15 0.35</ambient>
            <diffuse>0.10 0.85 0.25 0.35</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include><uri>model://stage1_stoneware_cylinder</uri><name>stoneware_l1_1</name><pose>0.62 -0.53 0.300000000000 0 0 0</pose></include>
