<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="stoneware_manipulator">
  <xacro:arg
    name="controllers_file"
    default="$(find stoneware_manipulation_test)/config/controllers.yaml"/>
  <xacro:property name="base_height" value="0.70"/>
  <xacro:property name="rail_height" value="0.10"/>
  <xacro:property name="radial_offset" value="0.30"/>
  <xacro:property name="tool_offset" value="0.12"/>

  <material name="base_gray">
    <color rgba="0.35 0.38 0.42 1"/>
  </material>
  <material name="rail_blue">
    <color rgba="0.15 0.35 0.75 1"/>
  </material>
  <material name="carriage_orange">
    <color rgba="0.85 0.42 0.12 1"/>
  </material>
  <material name="tool_black">
    <color rgba="0.12 0.12 0.14 1"/>
  </material>

  <link name="world"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 ${base_height / 2}" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia
        ixx="${12.0 * (3 * 0.16 ** 2 + base_height ** 2) / 12}"
        ixy="0"
        ixz="0"
        iyy="${12.0 * (3 * 0.16 ** 2 + base_height ** 2) / 12}"
        iyz="0"
        izz="${12.0 * 0.16 ** 2 / 2}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${base_height / 2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.16" length="${base_height}"/>
      </geometry>
      <material name="base_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height / 2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.16" length="${base_height}"/>
      </geometry>
    </collision>
  </link>

  <link name="turntable_link">
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.0324" ixy="0" ixz="0" iyy="0.0324" iyz="0" izz="0.0600"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.20" length="0.08"/>
      </geometry>
      <material name="base_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.20" length="0.08"/>
      </geometry>
    </collision>
  </link>

  <link name="rail_link">
    <inertial>
      <origin xyz="0.55 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia
        ixx="0.001225"
        ixy="0"
        ixz="0"
        iyy="0.1518625"
        iyz="0"
        izz="0.1518625"/>
    </inertial>
    <visual>
      <origin xyz="0.55 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.10 0.07 0.07"/>
      </geometry>
      <material name="rail_blue"/>
    </visual>
  </link>

  <link name="radial_carriage_link">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.003333" ixy="0" ixz="0" iyy="0.003033" iyz="0" izz="0.003667"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.14 0.16 0.12"/>
      </geometry>
      <material name="carriage_orange"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.14 0.16 0.12"/>
      </geometry>
    </collision>
  </link>

  <link name="lift_link">
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.002133" ixy="0" ixz="0" iyy="0.002133" iyz="0" izz="0.000683"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.08 0.08 0.16"/>
      </geometry>
      <material name="base_gray"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.08 0.08 0.16"/>
      </geometry>
    </collision>
  </link>

  <link name="tool_link">
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.000209" ixy="0" ixz="0" iyy="0.000209" iyz="0" izz="0.000378"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.055" length="0.03"/>
      </geometry>
      <material name="tool_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.055" length="0.03"/>
      </geometry>
    </collision>
  </link>

  <joint name="world_fixed_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="yaw_joint" type="revolute">
    <parent link="base_link"/>
    <child link="turntable_link"/>
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="30" velocity="1.2"/>
  </joint>

  <joint name="rail_fixed_joint" type="fixed">
    <parent link="turntable_link"/>
    <child link="rail_link"/>
    <origin xyz="0 0 ${rail_height}" rpy="0 0 0"/>
  </joint>

  <joint name="radial_joint" type="prismatic">
    <parent link="rail_link"/>
    <child link="radial_carriage_link"/>
    <origin xyz="${radial_offset} 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.70" effort="150" velocity="0.40"/>
  </joint>

  <joint name="lift_joint" type="prismatic">
    <parent link="radial_carriage_link"/>
    <child link="lift_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.35" upper="0.25" effort="120" velocity="0.25"/>
  </joint>

  <joint name="tool_fixed_joint" type="fixed">
    <parent link="lift_link"/>
    <child link="tool_link"/>
    <origin xyz="0 0 -${tool_offset}" rpy="0 0 0"/>
  </joint>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="radial_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="lift_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin
      filename="libgz_ros2_control-system.so"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>
</robot>
